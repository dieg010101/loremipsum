# sanity: reads go through the cdn; the token is only used to save contact messages
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=

# webstore gate: "true" opens /webstore, otherwise ?preview=<key> is required
STORE_OPEN=false
STORE_PREVIEW_KEY=

# contact form email (resend)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# newsletter + webstore notify-me sign-ups are posted here as json
# { email, tag, page, date } (the google sheet script). unset in dev: sign-ups are just logged.
NEWSLETTER_ENDPOINT=

# cloudflare turnstile (leave both empty to disable)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
