# sanity: read-only, through the cdn. the site needs no sanity token.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# contact form email (resend). CONTACT_FROM must be on a domain verified with resend;
# the sender also gets a copy from it.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# the google sheet (../backend/lorem-ipsum.gs): newsletter sign-ups, the visitors' book
# (approved by ticking a box) and an archive of contact messages. BACKEND_URL is the
# script's web app address; BACKEND_SECRET the same long random string as its SECRET.
# unset in development: everything is kept in memory and printed instead.
BACKEND_URL=
BACKEND_SECRET=

# cloudflare turnstile (leave both empty to disable). the production keys refuse localhost:
# in development use cloudflare's always-pass test keys,
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# run on the figma placeholder content instead of sanity (never in production).
DEMO_CONTENT=false

# viewer token for the studio preview tab (reads drafts, server only)
SANITY_VIEWER_TOKEN=
