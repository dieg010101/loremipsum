# sanity (server-side client, used for writing contact messages)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=

# webstore gate: "true" opens /webstore, otherwise ?preview=<key> is required
STORE_OPEN=false
STORE_PREVIEW_KEY=

# contact form email (resend)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# cloudflare turnstile (leave both empty to disable)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
